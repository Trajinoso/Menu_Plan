rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common hardened validation primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Recipe entity validation
    function isValidRecipe(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 500 &&
        (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 200)) &&
        (!('categories' in data) || data.categories == null || (data.categories is list && data.categories.size() <= 100)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 10000)) &&
        (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000000)) &&
        (!('timeMinutes' in data) || data.timeMinutes == null || (data.timeMinutes is number) || (data.timeMinutes is string)) &&
        (!('calories' in data) || data.calories == null || (data.calories is number) || (data.calories is string)) &&
        (!('servings' in data) || data.servings == null || (data.servings is number) || (data.servings is string)) &&
        (!('difficulty' in data) || data.difficulty == null || (data.difficulty is string && data.difficulty.size() <= 100)) &&
        (!('ingredients' in data) || data.ingredients == null || (data.ingredients is list && data.ingredients.size() <= 500)) &&
        (!('instructions' in data) || data.instructions == null || (data.instructions is list && data.instructions.size() <= 500)) &&
        (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 100)) &&
        (!('sourceUrl' in data) || data.sourceUrl == null || (data.sourceUrl is string && data.sourceUrl.size() <= 10000)) &&
        (!('isAiGenerated' in data) || data.isAiGenerated == null || (data.isAiGenerated is bool)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
        (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // AppState entity validation
    function isValidAppState(data) {
      return data.keys().hasAll(['id']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        (!('categories' in data) || data.categories == null || (data.categories is list && data.categories.size() <= 500)) &&
        (!('history' in data) || data.history == null || (data.history is list && data.history.size() <= 1000)) &&
        (!('weeklyPlan' in data) || data.weeklyPlan == null || data.weeklyPlan is map) &&
        (!('monthPlan' in data) || data.monthPlan == null || data.monthPlan is map) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 100)) &&
        (!('userId' in data) || data.userId == null || (data.userId is string && data.userId.size() <= 128));
    }

    // Recipe collection
    match /recipes/{recipeId} {
      allow get, list: if isSignedIn();
      allow create: if isVerified() && isValidId(recipeId) && isValidRecipe(incoming());
      allow update: if isVerified() && isValidId(recipeId) && isValidRecipe(incoming());
      allow delete: if isVerified() && isValidId(recipeId);
    }

    // Application synchronized state
    match /app_state/{stateId} {
      allow get, list: if isSignedIn();
      allow create: if isVerified() && isValidId(stateId) && isValidAppState(incoming());
      allow update: if isVerified() && isValidId(stateId) && isValidAppState(incoming());
      allow delete: if isVerified() && isValidId(stateId);
    }
  }
}
